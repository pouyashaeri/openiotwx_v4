# Copy to .env and change the passwords. Nothing here is sent anywhere.

# Database (TimescaleDB on Postgres 16)
POSTGRES_DB=iotwx
POSTGRES_USER=iotwx
POSTGRES_PASSWORD=change-me-now

# Which browsers may call the API. Add the address the site is served from.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://pouyashaeri.github.io

# MQTT topic filter the listener stores. Stations publish under ncar/iotwx/<state>/<place>/<station>.
MQTT_TOPIC=ncar/iotwx/#

# Metabase
METABASE_SITE_URL=http://localhost:3000
MB_SITE_NAME=OpenIoTwx community portal
MB_ADMIN_EMAIL=steward@example.org
MB_ADMIN_PASSWORD=change-me-too-12

# Place profile sources
EJAM_URL=https://api.ejanalysis.com
SVI_SERVICE=https://services3.arcgis.com/ZvidGQkLaDJxRSJ2/ArcGIS/rest/services/CDC_ATSDR_Social_Vulnerability_Index_2022_USA/FeatureServer

# Demo station (set DEMO_STATION=0 once a real station publishes)
DEMO_STATION=1
DEMO_STATION_ID=demo_station
DEMO_TOPIC=ncar/iotwx/co/demo/demo_station
DEMO_LAT=40.0150
DEMO_LON=-105.2705

# Forecasting (profile: forecast)
CREDIT_DEVICE=cpu            # cpu or cuda
CIRRUS_ENABLED=0             # 1 when the helm release on CIRRUS can accept runs

# Volunteer computing (profile: volunteer). The steward's BOINC project, or one another community runs.
BOINC_PROJECT_URL=
BOINC_ACCOUNT_KEY=
BOINC_GUI_RPC_PASSWORD=change-me-three

# Archive (profile: archive). GDEX publishing is OFF until a consent row exists and this is set.
GDEX_ENDPOINT=               # assigned by the GDEX team, see README
GDEX_TOKEN=
GDEX_COLLECTION=
GDEX_DRY_RUN=1               # 1 writes packages to exports/ only; 0 also uploads
