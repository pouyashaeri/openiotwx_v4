# Copy to .env and fill in. `docker compose up -d --build` reads it.

# Database password (any long random string).
POSTGRES_PASSWORD=change-me

# Signs login sessions. At least 32 characters; the server refuses to start in production with a short or
# example value. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-too

# Where people open the site. In production this must be your https address; it is the only address allowed to sign in.
PUBLIC_URL=http://localhost
SITE_ADDRESS=:80            # production: your domain, e.g. wx.example.edu

# Staff accounts. DEVELOPMENT ONLY: in production these lists are ignored, and the first account to sign up is
# an ordinary user. (An address is not verified, so typing someone's address at sign-up proves nothing.)
# Make an administrator on purpose, after they have signed up:
#   node scripts/make-admin.mjs person@ucar.edu superadmin      (see docs/DEPLOY.md)
# In development, with both lists empty, the first account becomes the super-admin.
SUPERADMIN_EMAILS=
ADMIN_EMAILS=

# Allow importing from CHORDS portals on private networks (default: public internet only).
CHORDS_ALLOW_PRIVATE=0

# How many web/API replicas to run, and how big each one's database pool is.
APP_REPLICAS=2
PG_POOL_MAX=20

# ── Optional: MQTT (docker compose --profile mqtt up -d) ──
INGEST_BRIDGE_TOKEN=
MQTT_BRIDGE_PASSWORD=

# ── Community hub (the Plan, Analysis, Forecast and Community pages' server, built into the site) ──
# A shared secret that lets the forecast runner and the place loader (infra/) write to the hub.
# Leave empty to disable them. Make one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HUB_TOKEN=
# Offer the community compute pool / NCAR CIRRUS as forecast backends once they exist.
BOINC_PROJECT_URL=
BOINC_ACCOUNT_KEY=
CIRRUS_ENABLED=0

# ── GDEX releases (NSF NCAR's data archive; see docs/GDEX.md) ──
# Who GDEX should contact about the dataset. A release is blocked until this is set (or filled in the admin console).
GDEX_CONTACT_EMAIL=
# A shared secret for the scheduler: docker compose --profile gdex up -d. Leave empty to build drafts by hand in the console.
# Make one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GDEX_RELEASE_TOKEN=

# ── Contact and support (see docs/SUPPORT.md) ──
# Where messages from the contact page are emailed, and the address shown to visitors. Leave empty to show none
# (messages are still saved and readable in the admin console, Support tab). An admin can also set it there.
SUPPORT_EMAIL=
# How to send that email: an SMTP URL like smtp://user:password@smtp.example.org:587 (use smtps:// for port 465).
# Leave empty and messages are only kept in the console.
SMTP_URL=
# The From address on those emails. Defaults to the SMTP user, or no-reply@<your site's host>.
SUPPORT_FROM=
# ── Planning chat (see docs/CHAT.md) ──
# Optional. Free-text answers in the chat are read by a small model on the server; the key never reaches the browser.
# With neither set, the chat uses keyword matching. Set ONE of these:
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CHAT_LLM_ENDPOINT=
CHAT_LLM_KEY=
CHAT_LLM_MODEL=
# Limits: messages per visitor per 10 minutes, and calls per day for the whole server.
CHAT_LLM_PER_10MIN=30
CHAT_LLM_DAILY_CAP=3000
