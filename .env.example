# Copy to .env and fill in. `docker compose up -d --build` reads it.

# Database password (any long random string).
POSTGRES_PASSWORD=change-me

# Signs login sessions. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me-too

# Where people open the site. Use your https domain in production (TLS is automatic).
PUBLIC_URL=http://localhost
SITE_ADDRESS=:80            # production: your domain, e.g. wx.example.edu

# Staff accounts (comma-separated emails). Super-admins can manage everyone, including admins;
# admins manage regular users. Staff sign in at /admin/login, a page that is linked from nowhere.
# If both are empty, the FIRST account that signs up becomes the super-admin, so create yours first.
SUPERADMIN_EMAILS=
ADMIN_EMAILS=

# Allow importing from CHORDS portals on private networks (default: public internet only).
CHORDS_ALLOW_PRIVATE=0

# How many web/API replicas to run, and how big each one's database pool is.
APP_REPLICAS=2
PG_POOL_MAX=20

# ── Optional: MQTT (docker compose --profile mqtt up -d) ──
INGEST_BRIDGE_TOKEN=
MQTT_BRIDGE_PASSWORD=

# ── Community hub (the Plan, Analysis, Forecast and Community pages' server, built into the site) ──
# A shared secret that lets the forecast runner and the place loader (infra/) write to the hub.
# Leave empty to disable them. Make one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HUB_TOKEN=
# Offer the community compute pool / NCAR CIRRUS as forecast backends once they exist.
BOINC_PROJECT_URL=
BOINC_ACCOUNT_KEY=
CIRRUS_ENABLED=0
