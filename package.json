{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build && npm run db:migrate",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test src/lib/wizard/recommend.test.ts src/lib/chat/engine.test.ts src/lib/chat/selection.test.ts src/lib/auth/gate-identity.test.ts src/lib/auth/sign-in-gate.test.ts src/lib/platform/parse.test.ts src/lib/platform/chords-format.test.ts src/lib/platform/forecast.test.ts src/lib/pi/commands.test.ts src/lib/legacy/gateway.test.ts src/lib/platform/summary.test.ts src/lib/gdex/release.test.ts src/lib/support/support.test.ts src/lib/platform/sample.test.ts src/lib/security/policy.test.ts src/lib/security/headers.test.ts",
    "lint": "eslint .",
    "e2e": "node scripts/e2e-platform.mjs && node scripts/e2e-admin.mjs",
    "e2e:chords": "node scripts/e2e-chords.mjs",
    "e2e:steps": "node scripts/e2e-steps.mjs",
    "e2e:pi": "node scripts/e2e-pi.mjs",
    "e2e:v3": "node scripts/e2e-v3.mjs",
    "e2e:map": "node scripts/e2e-map.mjs",
    "e2e:polish": "node scripts/e2e-polish.mjs",
    "e2e:flasher": "node scripts/e2e-flasher.mjs",
    "e2e:gdex": "node scripts/e2e-gdex.mjs",
    "e2e:chat": "node scripts/e2e-chat.mjs",
    "e2e:support": "node scripts/e2e-support.mjs",
    "e2e:security": "node scripts/e2e-security.mjs",
    "gdex:release": "node scripts/gdex-release.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "format": "prettier --write ."
  },
