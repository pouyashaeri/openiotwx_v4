{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Resolve every `app` replica from Docker DNS and balance across them.
	reverse_proxy {
		dynamic a app 8080 {
			refresh 5s
		}
		lb_policy least_conn
		health_uri /api/health
		health_interval 10s
		# A saturated replica answers 503 + Retry-After; try another one first.
		lb_retries 2
		lb_try_duration 2s
	}

	# Stations upload tiny JSON bodies; cap them well below anything abusive.
	request_body /api/* {
		max_size 1MB
	}
}
